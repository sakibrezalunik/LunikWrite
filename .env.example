# Lunik Write — environment variables
# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored and must never be committed.


# --- AI provider selection ---
# Which cloud AI provider to use.
#   groq   → Groq (primary, default)
#   gemini → Google Gemini (secondary, optional)
# There is no local/Ollama provider in this project.
AI_PROVIDER=groq


# --- Groq (primary cloud provider) ---
# Required when AI_PROVIDER=groq.
# Get a key from your Groq account dashboard.
# Server-side only — read by lib/ai/groq-provider.js, never sent to the browser.
# The key is sent in the Authorization: Bearer <key> header, never in a URL.
GROQ_API_KEY=

# Model to use with Groq. Default: openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b


# --- Google Gemini (secondary cloud provider) ---
# Required when AI_PROVIDER=gemini.
# GEMINI_API_KEY is the official variable name.
# GOOGLE_AI_API_KEY is accepted as an alias for the same key.
# Server-side only — read by lib/ai/gemini-provider.js, never sent to the browser.
# The key is sent in the x-goog-api-key header, never in a URL.
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Model to use with Gemini. Default: gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite


# --- CORS ---
# Allowed origin for cross-origin requests.
# Default: "*" (local development only).
# Set to your deployed domain in production.
ALLOWED_ORIGIN=


# --- Not yet used by any code in this project ---
# These are placeholders for a future accounts + database layer.
# Documents currently persist in the browser's localStorage only.
# Leaving these unset has no effect on the current app.
DATABASE_URL=
NEXTAUTH_SECRET=
